# Public base URL. Local: http://localhost:3000. Hosted: https://your-domain.example
# If APP_URL is empty on Render, SocialHub uses RENDER_EXTERNAL_URL automatically.
APP_URL=
PORT=3000
HOST=127.0.0.1

# REQUIRED: choose a long private password (at least 16 characters) for your SocialHub website.
APP_PASSWORD=

# Optional. Leave blank to generate and persist a local secret in DATA_DIR.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Persistent storage directory. Set to /var/data on Render or keep ./data locally.
DATA_DIR=./data

# Meta app (Facebook Pages)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v27.0

# Instagram API with Instagram Login (can be a separate Meta app)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok for Developers: Login Kit Web + Display API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google Cloud OAuth web client. Enable YouTube Data API v3 + YouTube Analytics API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

API_TIMEOUT_MS=15000
